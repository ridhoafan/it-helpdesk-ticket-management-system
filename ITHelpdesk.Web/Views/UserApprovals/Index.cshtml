@model ITHelpdesk.Web.Models.ViewModels.UserApprovalIndexViewModel
@using ITHelpdesk.Web.Models.Entities
@using System.Collections.Generic
@using System.Linq

@{
    ViewData["Title"] = "User Approval";

    var categories = ViewBag.Categories as IEnumerable<TicketCategory>
        ?? Enumerable.Empty<TicketCategory>();
}

<style>
    .approval-page {
        color: #1e293b;
    }

    .approval-header {
        margin-bottom: 28px;
    }

    .approval-header h2 {
        font-size: 25px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .approval-header p {
        color: #64748b;
        font-size: 14px;
        margin-bottom: 0;
    }

    .approval-summary {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 22px;
        margin-bottom: 24px;
    }

    .approval-summary-label {
        color: #64748b;
        font-size: 13px;
        margin-bottom: 8px;
    }

    .approval-summary-value {
        font-size: 30px;
        font-weight: 700;
        color: #0f172a;
    }

    .approval-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 22px;
        margin-bottom: 16px;
    }

    .user-avatar {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: #e0e7ff;
        color: #3730a3;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 16px;
        flex-shrink: 0;
    }

    .user-name {
        font-size: 16px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 4px;
    }

    .user-detail {
        font-size: 13px;
        color: #64748b;
        margin-bottom: 3px;
        overflow-wrap: anywhere;
    }

    .pending-badge {
        display: inline-block;
        background: #fef3c7;
        color: #92400e;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .approval-divider {
        border-top: 1px solid #e2e8f0;
        margin: 20px 0;
    }

    .approval-form label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 7px;
        color: #475569;
    }

    .approval-form .form-control {
        font-size: 13px;
        border-radius: 7px;
        padding: 10px 12px;
    }

    .approval-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        align-items: end;
    }

    .approval-actions .btn {
        font-size: 13px;
        font-weight: 600;
        padding: 10px 15px;
        border-radius: 7px;
    }

    .specialization-panel {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 9px;
        padding: 16px;
        margin-top: 16px;
    }

    .specialization-title {
        font-size: 13px;
        font-weight: 700;
        color: #334155;
        margin-bottom: 5px;
    }

    .specialization-description {
        font-size: 12px;
        color: #64748b;
        margin-bottom: 13px;
    }

    .specialization-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 10px;
    }

    .specialization-option {
        display: flex !important;
        align-items: center;
        gap: 9px;
        padding: 11px 12px;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 7px;
        cursor: pointer;
        margin: 0 !important;
    }

    .specialization-option input {
        width: 16px;
        height: 16px;
        margin: 0;
        flex-shrink: 0;
        accent-color: #2563eb;
    }

    .specialization-option span {
        font-size: 12px;
        color: #334155;
        font-weight: 600;
    }

    .empty-state {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 55px 20px;
        text-align: center;
    }

    .empty-state-icon {
        font-size: 38px;
        color: #16a34a;
        margin-bottom: 15px;
    }

    .empty-state h4 {
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .empty-state p {
        color: #64748b;
        font-size: 13px;
        margin: 0;
    }

    @@media (max-width: 576px) {
        .approval-card {
            padding: 17px;
        }

        .approval-actions {
            width: 100%;
        }

        .approval-actions form {
            flex: 1;
        }

        .approval-actions button {
            width: 100%;
        }
    }
</style>

<div class="approval-page">

    <!-- PAGE HEADER -->
    <div class="approval-header">
        <h2>User Approval</h2>
        <p>
            Review pendaftaran pengguna dan tentukan hak akses
            sebelum mereka dapat menggunakan sistem.
        </p>
    </div>

    <!-- NOTIFICATION MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- SUMMARY -->
    <div class="approval-summary">
        <div class="approval-summary-label">
            Accounts Awaiting Approval
        </div>

        <div class="d-flex align-items-center justify-content-between">
            <div class="approval-summary-value">
                @Model.PendingCount
            </div>

            <span class="pending-badge">
                Pending Review
            </span>
        </div>
    </div>

    <!-- PENDING USER LIST -->
    @if (Model.PendingUsers.Any())
    {
        @foreach (var user in Model.PendingUsers)
        {
            var initial = string.IsNullOrWhiteSpace(user.FullName)
                ? "?"
                : user.FullName.Substring(0, 1).ToUpperInvariant();

            var roleSelectId = $"role-{user.Id}";
            var specializationPanelId = $"specialization-{user.Id}";

            <div class="approval-card">

                <!-- USER INFORMATION -->
                <div class="d-flex align-items-start gap-3">

                    <div class="user-avatar">
                        @initial
                    </div>

                    <div class="flex-grow-1">

                        <div class="d-flex justify-content-between
                                    align-items-start gap-2 flex-wrap">

                            <div>
                                <div class="user-name">
                                    @user.FullName
                                </div>

                                <div class="user-detail">
                                    @@ @user.UserName
                                </div>

                                <div class="user-detail">
                                    @user.Email
                                </div>
                            </div>

                            <span class="pending-badge">
                                Pending
                            </span>

                        </div>

                        <div class="user-detail mt-2">
                            Registered:
                            @user.CreatedAtUtc.ToLocalTime()
                                .ToString("dd MMM yyyy, HH:mm")
                        </div>

                    </div>
                </div>

                <div class="approval-divider"></div>

                <!-- APPROVAL FORM -->
                <form asp-controller="UserApprovals"
                      asp-action="Approve"
                      method="post"
                      class="approval-form">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@user.Id" />

                    <div class="row g-3">

                        <div class="col-md-4">

                            <label for="@roleSelectId">
                                Assign Role
                            </label>

                            <select id="@roleSelectId"
                                    name="role"
                                    class="form-select form-control"
                                    data-role-select
                                    data-panel-id="@specializationPanelId"
                                    required>

                                <option value="Employee">
                                    Employee
                                </option>

                                <option value="IT Support">
                                    IT Support
                                </option>

                            </select>

                        </div>

                        <div class="col-md-5">

                            <label>Approval Note (Optional)</label>

                            <input type="text"
                                   name="note"
                                   class="form-control"
                                   maxlength="500"
                                   placeholder="Add an approval note..." />

                        </div>

                        <div class="col-md-3">

                            <label>Decision</label>

                            <div class="approval-actions">

                                <button type="submit"
                                        class="btn btn-success"
                                        onclick="return confirm('Approve this account?')">

                                    Approve
                                </button>

                            </div>

                        </div>

                    </div>

                    <!-- IT SUPPORT SPECIALIZATIONS -->
                    <div id="@specializationPanelId"
                         class="specialization-panel"
                         data-specialization-panel
                         hidden>

                        <div class="specialization-title">
                            IT Support Specializations
                        </div>

                        <div class="specialization-description">
                            Pilih satu atau beberapa kategori yang dapat
                            ditangani oleh IT Support ini.
                        </div>

                        @if (categories.Any())
                        {
                            <div class="specialization-grid">

                                @foreach (var category in categories)
                                {
                                    <label class="specialization-option"
                                           for="category-@user.Id-@category.Id">

                                        <input type="checkbox"
                                               id="category-@user.Id-@category.Id"
                                               name="categoryIds"
                                               value="@category.Id" />

                                        <span>
                                            @category.Name
                                        </span>

                                    </label>
                                }

                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-0">
                                Belum ada kategori aktif yang tersedia.
                            </div>
                        }

                    </div>

                </form>

                <!-- REJECTION FORM -->
                <form asp-controller="UserApprovals"
                      asp-action="Reject"
                      method="post"
                      class="approval-form mt-3">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@user.Id" />

                    <div class="row g-3 align-items-end">

                        <div class="col-md-9">

                            <label>Rejection Reason</label>

                            <input type="text"
                                   name="note"
                                   class="form-control"
                                   maxlength="500"
                                   placeholder="Explain why this registration is rejected..." />

                        </div>

                        <div class="col-md-3">

                            <button type="submit"
                                    class="btn btn-outline-danger w-100"
                                    onclick="return confirm('Reject this registration?')">

                                Reject

                            </button>

                        </div>

                    </div>

                </form>

            </div>
        }
    }
    else
    {
        <div class="empty-state">

            <div class="empty-state-icon">
                &#10003;
            </div>

            <h4>All Caught Up!</h4>

            <p>
                Tidak ada pendaftaran akun yang menunggu persetujuan.
            </p>

        </div>
    }

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const roleSelects = document.querySelectorAll("[data-role-select]");

        roleSelects.forEach(function (select) {

            function updateSpecializationVisibility() {

                const panelId = select.dataset.panelId;
                const panel = document.getElementById(panelId);

                if (!panel) {
                    return;
                }

                panel.hidden = select.value !== "IT Support";
            }

            select.addEventListener("change", updateSpecializationVisibility);

            updateSpecializationVisibility();
        });

    });
</script>