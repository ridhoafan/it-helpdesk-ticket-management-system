
@model ITHelpdesk.Web.Models.ViewModels.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IT Helpdesk</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: "Segoe UI", Arial, sans-serif;
            background: #f1f5f9;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            color: #1e293b;
        }

        .login-container {
            width: 100%;
            max-width: 430px;
        }

        .login-card {
            background: #ffffff;
            padding: 40px;
            border-radius: 16px;
            box-shadow: 0 15px 45px rgba(15, 23, 42, 0.08);
        }

        .brand {
            text-align: center;
            margin-bottom: 32px;
        }

        .brand-icon {
            width: 58px;
            height: 58px;
            background: #1e293b;
            color: #ffffff;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 18px;
            font-size: 25px;
            font-weight: 700;
        }

        .brand h1 {
            font-size: 25px;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 8px;
        }

        .brand p {
            font-size: 14px;
            color: #64748b;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 8px;
            color: #334155;
        }

        .form-control {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .form-control:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }

        .validation-error {
            display: block;
            color: #dc2626;
            font-size: 12px;
            margin-top: 6px;
        }

        .validation-summary {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #b91c1c;
            border-radius: 8px;
            padding: 12px 14px;
            font-size: 13px;
            margin-bottom: 20px;
        }

        .validation-summary:empty {
            display: none;
        }

        .validation-summary ul {
            margin-left: 18px;
        }

        .remember-me {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 24px;
            font-size: 13px;
            color: #475569;
        }

        .remember-me input {
            width: 15px;
            height: 15px;
            accent-color: #2563eb;
        }

        .login-button {
            width: 100%;
            padding: 13px;
            background: #1e293b;
            color: #ffffff;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
        }

        .login-button:hover {
            background: #334155;
        }

        .register-link {
            text-align: center;
            font-size: 13px;
            color: #64748b;
            margin-top: 22px;
        }

        .register-link a {
            color: #2563eb;
            font-weight: 600;
            text-decoration: none;
        }

        .register-link a:hover {
            text-decoration: underline;
        }

        .login-footer {
            text-align: center;
            font-size: 12px;
            color: #94a3b8;
            margin-top: 26px;
        }

        @@media (max-width: 480px) {
            .login-card {
                padding: 28px 22px;
            }
        }
    </style>
</head>

<body>
    <main class="login-container">
        <section class="login-card">

            <div class="brand">
                <div class="brand-icon">IT</div>
                <h1>IT Helpdesk</h1>
                <p>Sign in to access your support portal</p>
            </div>

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post">

                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>

                <div class="form-group">
                    <label asp-for="LoginIdentifier"></label>

                    <input asp-for="LoginIdentifier"
                           class="form-control"
                           placeholder="Masukkan email atau username"
                           autocomplete="username"
                           autofocus />

                    <span asp-validation-for="LoginIdentifier"
                          class="validation-error">
                    </span>
                </div>

                <div class="form-group">
                    <label asp-for="Password"></label>

                    <input asp-for="Password"
                           class="form-control"
                           placeholder="Masukkan password"
                           autocomplete="current-password" />

                    <span asp-validation-for="Password"
                          class="validation-error">
                    </span>
                </div>

                <label class="remember-me">
                    <input asp-for="RememberMe" />
                    <span>Ingat saya</span>
                </label>

                <button type="submit" class="login-button">
                    Sign In
                </button>

            </form>

            <div class="register-link">
                Belum memiliki akun?
                <a asp-controller="Account" asp-action="Register">
                    Daftar sekarang
                </a>
            </div>

            <div class="login-footer">
                IT Helpdesk & Ticket Management System
            </div>

        </section>
    </main>
</body>
</html>
