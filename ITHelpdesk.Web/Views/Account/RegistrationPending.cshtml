
@{
    Layout = null;
    ViewData["Title"] = "Menunggu Persetujuan";
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - IT Helpdesk</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: "Segoe UI", Arial, sans-serif;
            background: #f1f5f9;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            color: #1e293b;
        }

        .container {
            width: 100%;
            max-width: 480px;
        }

        .card {
            background: #ffffff;
            padding: 42px 38px;
            border-radius: 16px;
            text-align: center;
            box-shadow: 0 15px 45px rgba(15, 23, 42, 0.08);
        }

        .status-icon {
            width: 78px;
            height: 78px;
            background: #fef3c7;
            color: #d97706;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
            font-size: 38px;
        }

        h1 {
            font-size: 24px;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 12px;
        }

        .description {
            font-size: 14px;
            line-height: 1.8;
            color: #64748b;
            margin-bottom: 26px;
        }

        .status-box {
            background: #fffbeb;
            border: 1px solid #fde68a;
            border-radius: 10px;
            padding: 17px;
            margin-bottom: 26px;
        }

        .status-label {
            font-size: 11px;
            font-weight: 700;
            color: #92400e;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 7px;
        }

        .status-value {
            font-size: 15px;
            font-weight: 700;
            color: #b45309;
        }

        .steps {
            text-align: left;
            margin-bottom: 28px;
        }

        .step {
            display: flex;
            gap: 13px;
            margin-bottom: 17px;
        }

        .step-number {
            flex-shrink: 0;
            width: 27px;
            height: 27px;
            background: #e2e8f0;
            color: #334155;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 700;
        }

        .step-content strong {
            display: block;
            font-size: 13px;
            color: #334155;
            margin-bottom: 4px;
        }

        .step-content p {
            font-size: 12px;
            color: #94a3b8;
            line-height: 1.5;
        }

        .login-button {
            display: block;
            width: 100%;
            padding: 13px;
            background: #1e293b;
            color: #ffffff;
            border-radius: 8px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            transition: background 0.2s;
        }

        .login-button:hover {
            background: #334155;
        }

        .footer {
            margin-top: 25px;
            font-size: 12px;
            color: #94a3b8;
        }

        @@media (max-width: 480px) {
            .card {
                padding: 32px 22px;
            }
        }
    </style>
</head>

<body>
    <main class="container">
        <section class="card">

            <div class="status-icon">
                &#9203;
            </div>

            <h1>Pendaftaran Berhasil!</h1>

            <p class="description">
                Terima kasih telah mendaftarkan akun IT Helpdesk.
                Data pendaftaran kamu sudah kami terima dan
                sedang menunggu pemeriksaan dari Administrator.
            </p>

            <div class="status-box">
                <div class="status-label">Status Pendaftaran</div>
                <div class="status-value">
                    Menunggu Persetujuan Admin
                </div>
            </div>

            <div class="steps">

                <div class="step">
                    <div class="step-number">1</div>
                    <div class="step-content">
                        <strong>Pendaftaran diterima</strong>
                        <p>Data akun kamu sudah tersimpan di sistem.</p>
                    </div>
                </div>

                <div class="step">
                    <div class="step-number">2</div>
                    <div class="step-content">
                        <strong>Pemeriksaan Administrator</strong>
                        <p>Admin akan memeriksa dan menentukan jenis akses akun kamu.</p>
                    </div>
                </div>

                <div class="step">
                    <div class="step-number">3</div>
                    <div class="step-content">
                        <strong>Akun siap digunakan</strong>
                        <p>Setelah disetujui, kamu dapat login menggunakan email atau username.</p>
                    </div>
                </div>

            </div>

            <a asp-controller="Account"
               asp-action="Login"
               class="login-button">
                Kembali ke Halaman Login
            </a>

            <div class="footer">
                IT Helpdesk & Ticket Management System
            </div>

        </section>
    </main>
</body>
</html>
